# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

PORT=3000

# Comma-separated list of origins allowed to call the API from a browser.
# When unset, code defaults to the local dev frontends (localhost:3000/3001).
# Set this explicitly in production; never use "*" there.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

DATABASE_URL="postgresql://flowpay:change_me@localhost:5433/flowpay?schema=public"

# Default exchange rate seeded for every currency pair by the
# flowpay_default_exchange_rates migration. Read once when that migration is
# attested (node migration.ts); editing it later does not touch seeded rows.
EXCHANGE_RATE_DEFAULT="1"

# JWT auth
JWT_SECRET="replace-with-a-64+-char-random-string"
JWT_EXPIRES_IN="1d"
